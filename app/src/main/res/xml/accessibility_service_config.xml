<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt 958: what the accessibility service may see. It is told only when another app's window comes to the
     front (typeWindowStateChanged) and may read that window's content when the Python side asks. View ids are reported
     so a button can be found by its id. Nothing here lets it act without the user's per-app allowance in the chat. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200" />
